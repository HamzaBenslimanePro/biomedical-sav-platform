SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=

# Orchestration
DAGSTER_HOME=./.dagster

# Data generator
DATA_SEED=42
DATA_START_DATE=2023-01-01
DATA_END_DATE=2025-12-31
